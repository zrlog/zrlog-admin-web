    "antd": "6.4.3",
    "antd-style": "4.1.0",
    "md5": "2.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router": "6.30.3",
    "react-router-dom": "6.30.3",
    "rxjs": "7.8.1",
    "styled-components": "6.1.15",
    "yaml": "2.8.0"
  },
  "resolutions": {
    "@babel/plugin-transform-modules-systemjs": "7.29.4",
    "@babel/traverse": "7.29.7",
    "@rc-component/motion": "1.3.3",
    "@rc-component/util": "1.11.1",
    "@remix-run/router": "1.23.2",
    "axios": "1.18.0",
    "brace-expansion": "2.1.2",
    "braces": "3.0.3",
    "fast-uri": "3.1.5",
    "flatted": "3.4.2",
    "form-data": "4.0.6",
    "glob": "10.5.0",
    "js-yaml": "4.3.0",
    "jsonpath": "1.3.0",
    "lodash": "4.18.1",
    "minimatch": "9.0.7",
    "node-forge": "1.4.0",
    "postcss": "8.5.18",
    "rollup": "2.80.0",
    "serialize-javascript": "7.0.3",
    "shell-quote": "1.9.0",
    "svgo": "2.8.3",
    "underscore": "1.13.8",
    "websocket-driver": "0.7.5",
    "ws": "8.21.0"
  },
  "scripts": {
    "api-docs:check": "node ../../../scripts/check-api-docs.mjs",
    "lint": "yarn type-check",
    "prepare": "cd ../../../ && husky install src/main/frontend/.husky",
    "pre-commit": "yarn lint",
    "start": "craco start",
    "type-check": "tsc --project tsconfig.json --pretty --noEmit",
    "build": "cross-env GENERATE_SOURCEMAP=false craco build",
    "test": "craco test"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "devDependencies": {
    "@types/katex": "0.16.7",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/react-router": "5.1.20",
    "@types/react-router-dom": "5.3.3",
    "@typescript-eslint/typescript-estree": "8.38.0",
    "cross-env": "7.0.3",
    "husky": "7.0.4",
    "lint-staged": "11.1.2",
    "node": "18.9.0",
    "prettier": "2.3.2",
    "react-scripts": "5.0.1",
    "typescript": "5.8.3"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "lint-staged": {
    "*.tsx": [
      "prettier --write",
      "eslint --fix --max-warnings=0",
      "git add"
    ]
  }
}
